; ====================================================================================================
; MD.lib
; - Assembler and hardware definitions
; ====================================================================================================

; --------------------------------------------------
; Assembler
; --------------------------------------------------

; Constants

BYTE:					equ 1			; Byte width.
WORD:					equ 2			; Word width.
LONG:					equ 4			; Long width.

BYTE_MIN_U:				equ $00			; Byte minimum unsigned value.
BYTE_MIN_S:				equ -$7F		; Byte minimum signed value.
BYTE_MAX_U:				equ $FF			; Byte maximum unsigned value.
BYTE_MAX_S:				equ $7F			; Byte maximum signed value.
WORD_MIN_U:				equ $0000		; Word minimum unsigned value.
WORD_MIN_S:				equ -$7FFF		; Word minimum signed value.
WORD_MAX_U:				equ $FFFF		; Word maximum unsigned value.
WORD_MAX_S:				equ $7FFF		; Word maximum signed value.
LONG_MIN_U:				equ $00000000	; Long minimum unsigned value.
LONG_MIN_S:				equ -$7FFFFFFF	; Long minimum signed value.
LONG_MAX_U:				equ $FFFFFFFF	; Long maximum unsigned value.
LONG_MAX_S:				equ $7FFFFFFF	; Long maximum signed value.

; Macros

align:					macros
	cnop	0, \1

dseven:					macros
		ds.w	0

rseven:					macros
		rs.b	__rs&1

; --------------------------------------------------

; --------------------------------------------------
; 68k
; --------------------------------------------------

; Addresses

ram_start:				equ $FF0000			; RAM range.
ram_end:				equ $1000000

sram_start:				equ $200001			; SRAM range. * May not be supported on some flash carts/emulators.
sram_end:				equ $210000

; Constants

RAM_LEN:				equ ram_end-ram_start
SRAM_LEN:				equ sram_end-sram_start	; * May not be supported on some flash carts/emulators.

CLOCK_MASTER_NTSC:		equ 53693175
CLOCK_MASTER_PAL:		equ 53203424
CLOCK_68K_NTSC:			equ 7670454
CLOCK_68K_PAL:			equ 7600489

; Macros

	; Push/pop register macros

reg_push:				macros
		movem.l	d0-a6, -(sp)

reg_pop:				macros
		movem.l	(sp)+, d0-a6

reg_pushdreg:			macros
		movem.l	d0-d7, -(sp)

reg_popdreg:			macros
		movem.l	(sp)+, d0-d7

reg_pushareg:			macros
		movem.l	a0-a6, -(sp)

reg_popareg:			macros
		movem.l	(sp)+, a0-a6

	; Conditional jmps

jhi:					macro
		bls.s	@cont\@
		jmp		\1

@cont\@:
	endm

jls:					macro	dest
		bhi.s	@cont\@
		jmp		\1

@cont\@:
	endm

jcc:					macro	dest
		bcs.s	@cont\@
		jmp		\1

@cont\@:
	endm

jcs:					macro	dest
		bcc.s	@cont\@
		jmp		\1

@cont\@:
	endm

jne:					macro	dest
		beq.s	@cont\@
		jmp		\1

@cont\@:
	endm

jeq:					macro	dest
		bne.s	@cont\@
		jmp		\1

@cont\@:
	endm

jpl:					macro	dest
		bmi.s	@cont\@
		jmp		\1

@cont\@:
	endm

jmi:					macro	dest
		bpl.s	@cont\@
		jmp		\1

@cont\@:
	endm

jge:					macro	dest
		blt.s	@cont\@
		jmp		\1

@cont\@:
	endm

jlt:					macro	dest
		bge.s	@cont\@
		jmp		\1

@cont\@:
	endm

jgt:					macro	dest
		ble.s	@cont\@
		jmp		\1

@cont\@:
	endm

jle:					macro	dest
		bgt.s	@cont\@
		jmp		\1

@cont\@:
	endm

	; Absolute conversions

toabs:					macro	dest
		tst.\0	\dest
		bpl.s	@positive\@
		neg.\0	\dest

@positive\@:
	endm


movabs:					macro	src, dest
		move.\0	\src, \dest
		bpl.s	@positive\@
		neg.\0	\dest

@positive\@:
		rts
	endm

int_setlevel:			macros
		move.w	#$2000|(\1\<<8), sr

; --------------------------------------------------

; --------------------------------------------------
; Z80
; --------------------------------------------------

; Addresses

z80_ram:				equ $A00000			; Z80 RAM range.
z80_end:				equ $A02000

z80_busreq:				equ $A11100			; Z80 bus request line.
z80_reset:				equ $A11200			; Z80 reset line.

; Constants

Z80_LEN:				equ z80_end-z80_ram

CLOCK_Z80_NTSC:			equ 3579545
CLOCK_Z80_PAL:			equ 3546894

Z80_ASSERT:				equ $100
Z80_RELEASE:			equ $000

; Macros

z80_assertbus:			macros
		move.w	#Z80_ASSERT, z80_busreq

z80_releasebus:			macros
		move.w	#Z80_RELEASE, z80_busreq

z80_assertwait:			macro
@z80wait\@:
		btst	#0, z80_busreq
		bne.s	@z80wait\@
	endm

z80_releasewait:		macro
@z80wait\@:
		btst	#0, z80_busreq
		beq.s	@z80wait\@
	endm

z80_assertreset:		macros
		move.w	#Z80_ASSERT, z80_reset

z80_releasereset:		macros
		move.w	#Z80_RELEASE, z80_reset

; --------------------------------------------------

; --------------------------------------------------
; I/O
; --------------------------------------------------

; Addresses

io_sysinfo:				equ $A10001			; System information.
io_p1data:				equ $A10003			; I/O port 1 data.
io_p2data:				equ $A10005			; I/O port 2 data.
io_extdata:				equ $A10007			; EXT I/O data. * May not be supported on some consoles/emulators.
io_p1ctrl:				equ $A10009			; I/O port 1 control.
io_p2ctrl:				equ $A1000B			; I/O port 2 control.
io_extctrl:				equ $A1000D			; EXT I/O control. * May not be supported on some consoles/emulators.
io_p1tx:				equ $A1000F			; I/O port 1 serial transfer data. * May not be supported on some consoles/emulators.
io_p1rx:				equ $A10011			; I/O port 1 serial recieve data. * May not be supported on some consoles/emulators.
io_p1sctrl:				equ $A10013			; I/O port 1 serial control. * May not be supported on some consoles/emulators.
io_p2tx:				equ $A10015			; I/O port 2 serial transfer data. * May not be supported on some consoles/emulators.
io_p2rx:				equ $A10017			; I/O port 2 serial recieve data. * May not be supported on some consoles/emulators.
io_p2sctrl:				equ $A10019			; I/O port 2 serial control. * May not be supported on some consoles/emulators.
io_exttx:				equ $A1001B			; EXT port serial transfer data. * May not be supported on some consoles/emulators.
io_extrx:				equ $A1001D			; EXT port serial recieve data. * May not be supported on some consoles/emulators.
io_extsctrl:			equ $A1001F			; EXT port serial control. * May not be supported on some consoles/emulators.
io_edfifodat:			equ $A130D0			; EverDrive Core/Pro FIFO data register. * May not be supported on some flash carts/emulators.
io_edfifosts:			equ $A130D2			; EverDrive Core/Pro FIFO status register. * May not be supported on some flash carts/emulators.
io_edsts:				equ $A130D4			; EverDrive Core/Pro I/O status register. * May not be supported on some flash carts/emulators.
io_edtimer:				equ $A130D6			; EverDrive Core/Pro tick timer. * May not be supported on some flash carts/emulators.
io_edxfmath:			equ $A130D0			; EverDrive X3/X5/X7 fast multiply/divide register. * May not be supported on some flash carts/emulators.
io_edxspi:				equ $A130E0			; EverDrive X3/X5/X7 SPI data register. * May not be supported on some flash carts/emulators.
io_edxusb:				equ $A130E2			; EverDrive X3/X5/X7 USB data register. * May not be supported on some flash carts/emulators.
io_edxsts:				equ $A130E4			; EverDrive X3/X5/X7 I/O status register. * May not be supported on some flash carts/emulators.
io_edxconfig:			equ $A130E6			; EverDrive X3/X5/X7 I/O configuration. * May not be supported on some flash carts/emulators.
io_marssig:				equ $A130EC			; 32X "MARS" signature. * May not be supported on some flash carts/emulators.
io_mapperctrl			equ $A130F0			; ROM mapper control port. * May not be supported on some flash carts/emulators.
io_sramflg:				equ $A130F1			; ROM/SRAM access toggle. * May not be supported on some flash carts/emulators.
io_bank1:				equ $A130F3			; 512kb ROM bank page ID. * May not be supported on some flash carts/emulators.
io_bank2:				equ $A130F5
io_bank3:				equ $A130F7
io_bank4:				equ $A130F9
io_bank5:				equ $A130FB
io_bank6:				equ $A130FD
io_bank7:				equ $A130FF
io_tmsssig:				equ $A14000			; TMSS "SEGA" signature. * May not be supported on some consoles/emulators.
io_tmssflg:				equ $A14101			; TMSS cartridge boot flag. * May not be supported on some consoles/emulators.

; Constants

	; System information flags

SYSVER_NTSC:			equ %0000000		; NTSC clock flag.
SYSVER_PAL:				equ %0100000		; PAL clock flag.
SYSVER_DOM:				equ %0000000		; Domestic region flag.
SYSVER_INT:				equ %1000000		; International region flag.
SYSVER_EXPOFF:			equ %0010000		; Expansion slot off flag.

	; Joypad button values (cmp, and, or, clr, move...)

BTN_UP:					equ %0000000000000001
BTN_DOWN:				equ %0000000000000010
BTN_LEFT:				equ %0000000000000100
BTN_RIGHT:				equ %0000000000001000
BTN_B:					equ %0000000000010000
BTN_C:					equ %0000000000100000
BTN_A:					equ %0000000001000000
BTN_START:				equ %0000000010000000
BTN_Z:					equ %0000000100000000
BTN_Y:					equ %0000001000000000
BTN_X:					equ %0000010000000000
BTN_MODE:				equ %0000100000000000

	; Joypad button bit positions (btst, bclr, bset, bchg...)

BTN_UP_BIT:				equ 0
BTN_DOWN_BIT:			equ 1
BTN_LEFT_BIT:			equ 2
BTN_RIGHT_BIT:			equ 3
BTN_B_BIT:				equ 4
BTN_C_BIT:				equ 5
BTN_A_BIT:				equ 6
BTN_START_BIT:			equ 7
BTN_Z_BIT:				equ 0
BTN_Y_BIT:				equ 1
BTN_X_BIT:				equ 2
BTN_MODE_BIT:			equ 3

; --------------------------------------------------

; --------------------------------------------------
; VDP
; --------------------------------------------------

; Addresses

vdp_data:				equ $C00000			; VDP data port.
vdp_ctrl:				equ $C00004			; VDP control port.
vdp_hvcount:			equ $C00008			; VDP horizontal/vertical scanline counter. * May not be supported on some emulators.
vdp_dbreg:				equ $C00018			; VDP debug register selector. * May not be supported on some consoles/emulators.
vdp_debug:				equ $C0001C			; VDP debug register access. * May not be supported on some consoles/emulators.

; Constants

	; Lengths

TILE_LEN:				equ 32
SPR_LEN:				equ 8
VRAM_LEN:				equ $10000			; 64kb of VRAM.
CRAM_LEN:				equ 64*WORD			; 64 colours. Word sized.
VSRAM_LEN:				equ 20*2*WORD		; 20 two tile wide columns. 2 planes. Word sized.
HSCR_LEN:				equ 240*2*WORD		; 240 scanlines. 2 planes. Word sized.
SPRTBL_LEN:				equ 80*SPR_LEN		; 80 sprites. Sprite sized.

	; Clock speeds

CLOCK_VDP_NTSC:			equ 13423294
CLOCK_VDP_PAL:			equ 13300856
CLOCK_PIXEL_NTSC:		equ 6711647
CLOCK_PIXEL_PAL:		equ 6650428

	; Registers - https://segaretro.org/Sega_Mega_Drive/VDP_registers

vreg_mode1:				equ $8000			; VDP mode 1 register.
vreg_mode2:				equ $8100			; VDP mode 2 register.
vreg_plnavram:			equ $8200			; Plane A nametable VRAM address >> 10.
vreg_winvram:			equ $8300			; Window nametable VRAM address >> 10.
vreg_plnbvram:			equ $8400			; Plane B nametable VRAM address >> 13.
vreg_sprvram:			equ $8500			; Sprite table VRAM address >> 9.
vreg_sprvram2:			equ $8600			; Sprite table 128kb VRAM address >> 11.  * May not be supported on some consoles/emulators.
vreg_bgcolor:			equ $8700			; Background screen colour palette index.
vreg_msxscr:			equ $8800			; Master System background X scroll register. * May not be supported on some consoles/emulators.
vreg_msyscr:			equ $8900			; Master System background Y scroll register. * May not be supported on some consoles/emulators.
vreg_hintrt:			equ $8A00			; Horizontal interrupt rate.
vreg_mode3:				equ $8B00			; VDP mode 3 register.
vreg_mode4:				equ $8C00			; VDP mode 4 register.
vreg_hscrvram:			equ $8D00			; Horizontal scroll table VRAM address >> 10.
vreg_plnvram2:			equ $8E00			; Plane A and B 128kb VRAM address. (A>>16) ((B&$10000)>>12). * May not be supported on some consoles/emulators.
vreg_autoinc:			equ $8F00			; VDP address access auto increment value.
vreg_plnsize:			equ $9000			; Plane map size.
vreg_winx:				equ $9100			; Window layer X division point.
vreg_winy:				equ $9200			; Window layer Y division point.

dma_len:				equ $94009300		; DMA operation length >> 1.
dma_src:				equ $96009500		; DMA source address >> 1.
dma_cmd:				equ $9700			; DMA operation type and upper byte of soure address >> 1.

	; Commands - https://plutiedev.com/vdp-commands

VCMD_VRAM_READ:			equ $00000000
VCMD_VRAM_WRITE:		equ $40000000
VCMD_VRAM_DMA:			equ $40000080

VCMD_CRAM_READ:			equ $00000020
VCMD_CRAM_WRITE:		equ $C0000000
VCMD_CRAM_DMA:			equ $C0000080

VCMD_VSRAM_READ:		equ $00000010
VCMD_VSRAM_WRITE:		equ $40000010
VCMD_VSRAM_DMA:			equ $40000090

	; Tile ID flags - https://plutiedev.com/tile-id

TILE_HFLIP:				equ $0800			; Horizontal flip.
TILE_VFLIP:				equ $1000			; Vertical flip.
TILE_PAL1:				equ $2000			; Palette line 1.
TILE_PAL2:				equ $4000			; Palette line 2.
TILE_PAL3:				equ $6000			; Palette line 3.
TILE_HIPRI:				equ $8000			; High priority.

	; Sprite variables - https://plutiedev.com/sprite-table

spr_ypos:				equ 0				; Y position.
spr_size:				equ 2				; Size.
spr_link:				equ 3				; Next sprite.
spr_tile:				equ 4				; Tile ID and flags.
spr_xpos:				equ 6				; X position.

	; Mode 1 flags

MODE1_BLKLC:			equ %100000			; Blank left most tile column.
MODE1_HINT:				equ %010000			; Enable horizontal interrupts.
MODE1_HICOL:			equ %000100			; High colour mode.
MODE1_FRZHV:			equ %000010			; Freeze H/V counter during EXT interrupt.
MODE1_DISOFF:			equ %000001			; Disable display.

	; Mode 2 flags

MODE2_128K:				equ %10000000		; 128kb VRAM mode. * May not be supported on some consoles/emulators.
MODE2_DISON:			equ %01000000		; Enable display.
MODE2_VINT:				equ %00100000		; Enable vertical interrupts.
MODE2_DMA:				equ %00010000		; Enable DMA operations.
MODE2_V30:				equ %00001000		; V30 resolution. * PAL only.
MODE2_MD:				equ %00000100		; Mega Drive video mode.

	; Mode 3 flags

MODE3_EXT:				equ %1000			; Enable external I/O interrupts.
MODE3_COLSCR:			equ %0100			; Per column vertical scrolling.
MODE3_ROWSCR:			equ %0010			; Per row horizontal scrolling.
MODE3_LINESCR:			equ %0011			; Per scanline horizontal scrolling.

	; Mode 4 flags

MODE4_H40:				equ %10000001		; H40 resolution.
MODE4_CLOCK:			equ %01000000		; Use pixel clock signal.
MODE4_FRZHS:			equ %00100000		; Freeze H-sync.
MODE4_EXTBUS:			equ %00010000		; Use external pixel bus.
MODE4_SH:				equ %00001000		; Enable shadow/highlight.
MODE4_INT:				equ %00000010		; Enable interlacing.
MODE4_TALL:				equ %00000110		; Enable double resolution with interlacing.

	; Plane sizes

PLNSIZE_32X32:			equ %000000
PLNSIZE_64X32:			equ %000001
PLNSIZE_128X32:			equ %000011
PLNSIZE_32X64:			equ %010000
PLNSIZE_64X64:			equ %010001
PLNSIZE_32X128:			equ %110000

	; DMA command types

DMACMD_XFER:			equ %00000000		; Transfer from 68k to VRAM/CRAM/VSRAM
DMACMD_FILL:			equ %10000000		; Fill VRAM with value.
DMACMD_COPY:			equ %11000000		; Copy VRAM to VRAM.

; Macros

vdp_docmd:				macro	type, rwd, dest, ctrl
	local cmd
cmd:	equ VCMD_\type\_\rwd\|((\dest\&$3FFF)<<16)|((\dest\&$C000)>>14)
	if narg<4
		move.l	#\#cmd, vdp_ctrl
	else
		move.l	#\#cmd, \ctrl
	endif
	endm

vdp_vsync:				macro
		int_setlevel 3

@vsyncwait\@:
		btst	#7, vdp_ctrl+1				; Has a vertical interrupt occurred?
		beq.s	@vsyncwait\@				; If not, keep waiting.
	endm

; --------------------------------------------------

; --------------------------------------------------
; Sound
; --------------------------------------------------

; Addresses

ym_a0:					equ $A04000			; YM2612 register address.
ym_d0:					equ $A04001			; YM2612 register data.
ym_a1:					equ $A04002
ym_d1:					equ $A04003

psg_ctrl:				equ $C00011			; PSG control port.

; Constants

	; Clock speeds

CLOCK_YM_NTSC:			equ CLOCK_68K_NTSC
CLOCK_YM_PAL:			equ CLOCK_68K_PAL
CLOCK_PSG_NTSC:			equ CLOCK_Z80_NTSC
CLOCK_PSG_PAL:			equ CLOCK_Z80_PAL

	; Registers

