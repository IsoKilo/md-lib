; Mega CD  * May not be supported on some consoles/flash carts/emulators.
; --------------------------------------------------

; Addresses

; Constants

	; Lengths

; Macros

; --------------------------------------------------

; --------------------------------------------------
; 32X  * May not be supported on some consoles/flash carts/emulators.
; --------------------------------------------------

; Addresses

mars_frmbuff:			equ $840000			; 32X framebuffer.
mars_frmbuff2:			equ $860000
mars_fixedrom:			equ $880000			; 32X fixed ROM bank.
mars_bankrom:			equ $900000			; 32X switchable ROM bank.

; Constants

	; Clock speeds

CLOCK_MARS_NTSC:		equ 23011360
CLOCK_MARS_PAL:			equ 22801467

	; Lengths

MARSROM_LEN:			equ $10000
FRMBUFF_LEN:			equ mars_frmbuff2-mars_frmbuff

